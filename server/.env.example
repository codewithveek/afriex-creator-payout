# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/afriex_creator_payout

# --- Server ---
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# --- Auth (better-auth) ---
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:4000

# --- Redis (BullMQ queue + cache) ---
REDIS_URL=redis://localhost:6379

# --- Stripe (collection layer) ---
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Afriex Business API (disbursement layer) ---
AFRIEX_API_KEY=replace-with-afriex-key
AFRIEX_WEBHOOK_PUBLIC_KEY=replace-with-afriex-webhook-public-key

# --- Encryption (for payout method secrets at rest) ---
# 32-byte key, base64 encoded. Generate with: openssl rand -base64 32
PAYOUT_SECRETS_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# --- Resend (transactional email) ---
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=payouts@yourdomain.com

# --- Disbursement policy (platform-wide defaults) ---
# Minimum balance required to trigger an on-demand withdrawal (minor units, e.g. cents)
WITHDRAWAL_MIN_AMOUNT_MINOR=500
# Cooldown between on-demand withdrawals, in hours
WITHDRAWAL_COOLDOWN_HOURS=24
# Scheduled disbursement cadence: weekly | biweekly | monthly
SCHEDULED_DISBURSEMENT_CADENCE=weekly
# Percentage of gross sale amount retained as platform fee
PLATFORM_FEE_PERCENT=10
